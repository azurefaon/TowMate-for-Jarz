# PayMongo SANDBOX pilot environment (copy to .env.pilot, which is git-ignored).
# Run the app with APP_ENV=pilot so this file is loaded INSTEAD of .env (the shared development database).
# Fill the blanks locally. Never commit real values, and never paste them into chat or logs.

APP_NAME=TowMate-pilot
APP_ENV=pilot
APP_KEY=
APP_DEBUG=false
# The public https URL of your temporary tunnel (a domain name; PayMongo rejects IP addresses and http).
APP_URL=https://CHANGE-ME.example

LOG_CHANNEL=single
LOG_LEVEL=info

# A throw-away database. Its name MUST end in _pilot (or _testing/_sandbox/_isolated) or the pilot commands refuse to run.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=towmate_pilot
DB_USERNAME=
DB_PASSWORD=

# Nothing here should reach real people or services.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
BROADCAST_CONNECTION=log
TL_DEMO_ARRIVAL_ENABLED=false

# --- PayMongo sandbox -------------------------------------------------------
PAYMONGO_SANDBOX_ENABLED=true
PAYMONGO_SANDBOX_ENVIRONMENTS=pilot
# An sk_test_ key only (Developers > API Keys, TEST mode). Live keys are refused.
PAYMONGO_SECRET_KEY=
# Shown once when the webhook endpoint is created in the dashboard (TEST mode).
PAYMONGO_WEBHOOK_SECRET=
# The id printed by: php artisan online-payments:make-pilot-fixture
PAYMONGO_SANDBOX_TEST_USER_IDS=
# Served by the pilot gateway; confirms nothing. Use your tunnel host.
PAYMONGO_SUCCESS_URL=https://CHANGE-ME.example/pilot/return?result=success
PAYMONGO_CANCEL_URL=https://CHANGE-ME.example/pilot/return?result=cancelled
