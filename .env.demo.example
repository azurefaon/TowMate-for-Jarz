# Owner Finance DEMONSTRATION environment (Phase 10).
# Copy to .env.demo (git-ignored) and run:  php artisan finance:demo-reset --env=demo
# The database MUST be a separate, disposable database whose name ends with "_demo".
# Never point this file at a database that holds real bookings, payments or finance records.

APP_NAME=TowMate
APP_ENV=demo
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8010

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=towmate_finance_demo
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Keep every outside service off in the demo.
MAIL_MAILER=log
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
TL_DEMO_ARRIVAL_ENABLED=false

FINANCE_DEMO_ENABLED=true
FINANCE_DEMO_OWNER_EMAIL=demo.owner@towmate.test
# Set a password for the demo accounts; if empty, the reset prints a generated one.
FINANCE_DEMO_PASSWORD=
