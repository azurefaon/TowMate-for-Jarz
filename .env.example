APP_NAME=TowMate
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jarztowing.up.railway.app
CORS_ALLOWED_ORIGINS=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TowMate"

SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=
SYSTEM_ADMIN_NAME=

GOOGLE_MAPS_API_KEY=

GOOGLE_CLIENT_ID=

TOWMATE_TERMS_VERSION=1.0
TOWMATE_PRIVACY_VERSION=1.0

# Presentation-only Team Leader demo arrival. Keep false in normal operation.
TL_DEMO_ARRIVAL_ENABLED=false
# Comma-separated Team Leader emails allowed to use it while the flag is true (e.g. a@x.com,b@x.com). Leave blank otherwise.
TL_DEMO_TEAM_LEADER_EMAILS=

# PayMongo SANDBOX (test mode only). Disabled unless explicitly turned on; never commit real values.
# Only an sk_test_ key is accepted; live keys are rejected. See docs/PAYMONGO_SANDBOX_RUNBOOK.md.
PAYMONGO_SANDBOX_ENABLED=false
PAYMONGO_SANDBOX_ENVIRONMENTS=local,testing,staging
# Capstone demo only: production runs the TEST-mode sandbox only with this explicit opt-in.
PAYMONGO_SANDBOX_ALLOW_PRODUCTION=false
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Dedicated test customers only (comma-separated user ids and/or emails).
PAYMONGO_SANDBOX_TEST_USER_IDS=
PAYMONGO_SANDBOX_TEST_USER_EMAILS=
