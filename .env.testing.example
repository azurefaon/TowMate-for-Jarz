APP_NAME=TowMate
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Must point at a DEDICATED PostgreSQL test database — never the real
# development database (towmate_jarz) and never Railway production.
# The database name MUST contain a clear test marker; this project's
# tests/TestCase.php guard hard-fails unless it is exactly towmate_jarz_testing.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=towmate_jarz_testing
DB_USERNAME=
DB_PASSWORD=

# DATABASE_URL must NOT be set here — if present it overrides DB_* above
# and the test-safety guard will refuse to run.

SESSION_DRIVER=array
SESSION_LIFETIME=120
CACHE_STORE=array
QUEUE_CONNECTION=sync

MAIL_MAILER=array

TL_DEMO_ARRIVAL_ENABLED=false
